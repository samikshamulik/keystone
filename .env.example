# ─────────────────────────────────────────────────────────────────────────────
# KEYSTONE Environment Variables
# Copy this file to .env for local development — never commit the real .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (local dev uses Docker on port 5433) ────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5433/keystone
DATABASE_USERNAME=keystone
DATABASE_PASSWORD=keystone

# ── JWT — CHANGE THIS in production (min 32 chars, random string) ────────────
JWT_SECRET=keystone-super-secret-jwt-key-change-in-production-2024
JWT_EXPIRATION_MS=86400000

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8081

# ── CORS — set to your Vercel frontend URL in production ─────────────────────
# Example: ALLOWED_ORIGINS=https://keystone-app.vercel.app
ALLOWED_ORIGINS=

# ── Frontend (set this in Vercel dashboard, not here) ────────────────────────
# VITE_API_URL=https://keystone-api.onrender.com
